bazel_dep(name = "rules_cc", version = "0.0.9")

# Test rules_cc PR #863.
archive_override(
    module_name = "rules_cc",
    integrity = "sha256-IKSf/5DlwFfGdwMrpY/7Y+EXq4uSnp2eRK0bTrhJxXg=",
    strip_prefix = "rules_cc-1ab54487e4e37fe0a6e867cf6d426a6badc99345",
    urls = ["https://github.com/bazelbuild/rules_cc/archive/1ab54487e4e37fe0a6e867cf6d426a6badc99345.tar.gz"],
)

bazel_dep(name = "rules_java", version = "8.12.0")
bazel_dep(name = "rules_python", version = "0.36.0")
bazel_dep(name = "rules_shell", version = "0.3.0")

python = use_extension("@rules_python//python/extensions:python.bzl", "python")
python.toolchain(python_version = "3.11")
