 )
 
+def _rust_proc_macro_transition_impl(settings, attr):
+    per_crate_flags = [] if getattr(attr, "skip_per_crate_rustc_flags", False) else settings[_PER_CRATE_FLAG_SETTING]
+    proc_macro_platform = settings[_PROC_MACRO_PLATFORM_SETTING]
+    if proc_macro_platform and proc_macro_platform != _NO_PROC_MACRO_PLATFORM:
+        platforms = [proc_macro_platform]
+    else:
+        platforms = settings["//command_line_option:platforms"]
+    return {
+        "//command_line_option:platforms": platforms,
+        _PER_CRATE_FLAG_SETTING: per_crate_flags,
+    }
+
+_rust_proc_macro_transition = transition(
+    implementation = _rust_proc_macro_transition_impl,
+    inputs = [
+        "//command_line_option:platforms",
+        _PER_CRATE_FLAG_SETTING,
+        _PROC_MACRO_PLATFORM_SETTING,
+    ],
+    outputs = [
+        "//command_line_option:platforms",
+        _PER_CRATE_FLAG_SETTING,
+    ],
+)
+
 rust_proc_macro = rule(
     implementation = _rust_proc_macro_impl,
     provides = COMMON_PROVIDERS,
-    cfg = per_crate_flag_trim_transition,
+    cfg = _rust_proc_macro_transition,
     attrs = {name: value for name, value in _COMMON_ATTRS.items() if name != "link_deps"} | {
