load("@platforms//host:constraints.bzl", "HOST_CONSTRAINTS")

package(default_visibility = ["//visibility:public"])

filegroup(
    name = "zipper",
    srcs = select({
        ":matches_host_constraints": glob(["zipper/*"]),
        "//conditions:default": [":zipper_non_host"],
    }),
)

# Keep the embedded host binary above to avoid fetching an archive for
# same-platform builds. For other platforms, prefer a native prebuilt where
# available and retain the C++ source fallback for unsupported platforms.
alias(
    name = "zipper_non_host",
    actual = select({
        ":darwin_arm64_platform": "@remote_java_tools_darwin_arm64//:zipper_prebuilt_binary",
        "//src/conditions:darwin_x86_64": "@remote_java_tools_darwin_x86_64//:zipper_prebuilt_binary",
        "//src/conditions:linux_aarch64": "@remote_java_tools_linux_aarch64//:zipper_prebuilt_binary",
        "//src/conditions:linux_x86_64": "@remote_java_tools_linux//:zipper_prebuilt_binary",
        ":windows_x86_64_platform": "@remote_java_tools_windows//:zipper_prebuilt_binary",
        "//conditions:default": "//third_party/ijar:zipper",
    }),
    visibility = ["//visibility:private"],
)

alias(
    name = "unzip_fdo",
    actual = "zipper",
)

# The legacy darwin_arm64 config setting also matches --cpu. Use only platform
# constraints here: the legacy CPU flag may still describe a non-Linux client
# when the execution platform is Linux.
config_setting(
    name = "darwin_arm64_platform",
    constraint_values = [
        "@platforms//cpu:aarch64",
        "@platforms//os:macos",
    ],
    visibility = ["//visibility:private"],
)

config_setting(
    name = "windows_x86_64_platform",
    constraint_values = [
        "@platforms//cpu:x86_64",
        "@platforms//os:windows",
    ],
    visibility = ["//visibility:private"],
)

config_setting(
    name = "matches_host_constraints",
    constraint_values = HOST_CONSTRAINTS,
    visibility = ["//visibility:private"],
)
